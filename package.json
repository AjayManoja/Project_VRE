{
  "name": "vre-around",
  "displayName": "VRE + Around",
  "description": "Makes your code editor aware of your real hardware. Catches logic bugs locally, manages dependencies across machines, monitors resources in real-time.",
  "version": "1.0.0",
  "publisher": "AjayManoja",
  "author": {
    "name": "Ajay Manoja",
    "url": "https://github.com/AjayManoja"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AjayManoja/Project_VRE.git"
  },
  "bugs": {
    "url": "https://github.com/AjayManoja/Project_VRE/issues"
  },
  "homepage": "https://github.com/AjayManoja/Project_VRE#readme",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "VRE",
    "environment",
    "hardware",
    "dependency",
    "proxy",
    "container",
    "monitor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vre.scanDependencies",
        "title": "Scan Dependencies",
        "category": "VRE"
      },
      {
        "command": "vre.translateAndRun",
        "title": "Translate & Run",
        "category": "VRE"
      },
      {
        "command": "vre.startMonitor",
        "title": "Start Monitor",
        "category": "VRE"
      },
      {
        "command": "vre.stopMonitor",
        "title": "Stop Monitor",
        "category": "VRE"
      },
      {
        "command": "vre.viewDelta",
        "title": "View Delta.X",
        "category": "VRE"
      }
    ],
    "keybindings": [
      {
        "command": "vre.translateAndRun",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && resourceExtname =~ /\\.(py|js)$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vre.translateAndRun",
          "when": "resourceExtname =~ /\\.(py|js)$/",
          "group": "vre@1"
        }
      ]
    },
    "configuration": {
      "title": "VRE + Around",
      "properties": {
        "vre.monitor.intervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "description": "Hardware polling interval in seconds."
        },
        "vre.logging.level": {
          "type": "string",
          "default": "info",
          "enum": ["debug", "info", "warn", "error"],
          "description": "Log verbosity."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.mjs --production",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.56.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
